{
  "name": "@kouji-ui/core",
  "version": "0.8.5",
  "description": "Headless Angular UI primitives — signal-driven directives with WCAG 2.1 AAA semantics, no CDK, and a handful of opt-in global stylesheets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouji-dev/kouji-ui.git",
    "directory": "packages/core"
  },
  "homepage": "https://kouji-ui.onrender.com",
  "bugs": {
    "url": "https://github.com/kouji-dev/kouji-ui/issues"
  },
  "keywords": [
    "angular",
    "ui",
    "headless",
    "directives",
    "a11y",
    "wcag",
    "signals"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false,
    "directory": "../../dist/kj-core"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "rxjs": "^7.8.0",
    "echarts": "^6.0.0",
    "lexical": "^0.38.0",
    "@lexical/rich-text": "^0.38.0",
    "@lexical/list": "^0.38.0",
    "@lexical/link": "^0.38.0",
    "@lexical/history": "^0.38.0",
    "@lexical/markdown": "^0.38.0",
    "@lexical/code": "^0.38.0",
    "@lexical/html": "^0.38.0",
    "@lexical/selection": "^0.38.0",
    "monaco-editor": "^0.55.0",
    "@monaco-editor/loader": "^1.7.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": {
      "style": "./styles.css",
      "default": "./styles.css"
    },
    "./overlay/overlay.css": {
      "style": "./overlay/overlay.css",
      "default": "./overlay/overlay.css"
    },
    "./icon/icon.css": {
      "style": "./icon/icon.css",
      "default": "./icon/icon.css"
    },
    "./typography/prose.css": {
      "style": "./typography/prose.css",
      "default": "./typography/prose.css"
    },
    "./motion/motion.css": {
      "style": "./motion/motion.css",
      "default": "./motion/motion.css"
    }
  },
  "scripts": {
    "build": "node ../../scripts/check-public-api-graph.mjs core && ng-packagr -p ng-package.json -c tsconfig.lib.prod.json && node ../../scripts/write-core-styles.mjs && node ../../scripts/check-package-exports.mjs core",
    "test": "vitest run",
    "typecheck": "ngc -p tsconfig.typecheck.json",
    "lint": "ng lint kj-core"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "lexical": {
      "optional": true
    },
    "@lexical/rich-text": {
      "optional": true
    },
    "@lexical/list": {
      "optional": true
    },
    "@lexical/link": {
      "optional": true
    },
    "@lexical/history": {
      "optional": true
    },
    "@lexical/markdown": {
      "optional": true
    },
    "@lexical/code": {
      "optional": true
    },
    "@lexical/html": {
      "optional": true
    },
    "@lexical/selection": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    },
    "@monaco-editor/loader": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/angular-table": "^8.21.4"
  }
}
