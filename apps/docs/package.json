    "typecheck": "ngc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@kouji-ui/components": "workspace:*",
    "@kouji-ui/themes": "workspace:*",
    "lucide-static": "^1.14.0",
    "zod": "^4.4.3"
  }
}
